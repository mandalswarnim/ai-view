# Copy to apps/web/.env.local (web app + accuracy script) and fill in.
# The extension reads its one setting from apps/extension/.env.local (see bottom).

# --- Anthropic (required for real analyses) -------------------------------
ANTHROPIC_API_KEY=
# Vision-capable model used for analysis. Any current Claude model works;
# claude-opus-5-5 is the default, claude-sonnet-5-5 / claude-haiku-5-5 are cheaper.
ANTHROPIC_MODEL=claude-opus-5-5

# --- Supabase (optional in local dev) -------------------------------------
# Without these, reports and rate-limit counters are kept in apps/web/.data/
# on local disk, which is fine for development but not for Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Analysis limits -------------------------------------------------------
# New (uncached) analyses allowed per anonymous install ID per day.
ANALYSES_PER_DAY=10
# Photos sent to the model per listing (hard cap is 20).
MAX_PHOTOS=20

# --- Public site settings --------------------------------------------------
# Where "Report an error" and dispute emails go.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# Public origin of the web app, used to build links inside reports.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Extension (put this line in apps/extension/.env.local) ----------------
# Origin of the API the extension calls. Also becomes a host permission.
WXT_API_BASE_URL=http://localhost:3000
